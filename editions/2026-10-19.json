 "ai_stories": [
  {
   "id": "chip-rout",
   "headline": "Chip stocks fall for an eighth straight day",
   "facts": [
    "SOX 11,137.29 -3.83% on 16 Oct, eighth straight fall, -11.4% week",
    "~$2tn lost over run; still up ~60% YTD (Stocktwits)",
    "BofA: AI trade resilient, risk priced in"
   ],
   "sources": [
    "https://finance.biggo.com/news/4653f52e-d964-4a23-90e0-9b2091a94646",
    "https://stocktwits.com/news-articles/markets/equity/semiconductor-stocks-sox-losing-streak-2-trillion-ai-selloff/cZxKaOoRBsy",
    "https://finance.yahoo.com/markets/live/stock-market-today-dow-sp-500-nasdaq-futures-mixed-amid-volatile-week-112939401.html"
   ],
   "paragraph": "A stock index is just an average: add up the prices of a group of companies and watch whether the total goes up or down. The Philadelphia Semiconductor Index, which tracks US-listed chip makers, closed Friday at 11,137.29, down 3.83%, its eighth straight daily fall and 11.4% lower on the week, with every member down. Stocktwits said about $2tn of market value vanished over the run, yet the index was still up nearly 60% this year. Outlets blamed hot inflation data, a 10-year Treasury yield near 5.1%, pricier oil, and doubts about borrowing to build AI data centres. Bank of America called the AI trade resilient and said the risk is priced in. Is this a pause or a turn? Nobody knows yet, and the streak comparisons are approximate.",
   "edited": "none",
   "explainer": "sonnet"
  },
  {
   "id": "nscale-ipo",
   "headline": "Investors push back on Nscale's IPO price",
   "facts": [
    "Seeking ~$30bn valuation; investors suggest $16bn-19bn (Bloomberg via Crypto Briefing)",
    "H1 2026 revenue $140.6m, net loss $1.02bn",
    "$103.4bn contracted, ~2.5% active",
    "Microsoft UK withdrawal reported, unconfirmed"
   ],
   "sources": [
    "https://cryptobriefing.com/nscale-ipo-valuation-investor-pushback/",
    "https://www.tipranks.com/news/microsoft-msft-exits-uk-data-center-deal-ahead-of-nscales-3b-ipo"
   ],
   "paragraph": "An IPO is when a private company sells shares to the public for the first time, and the hard part is agreeing on a price. Nscale, an Nvidia-backed data-centre builder, wants to raise about $3bn on the New York Stock Exchange at a roughly $30bn valuation, but Bloomberg reports investors are pushing back, with some saying $16bn to $19bn is more realistic. Its last private value was $14.6bn. Revenue jumped to $140.6m in early 2026, yet the net loss was $1.02bn. About $103.4bn of future contracts sounds huge, but only about 2.5% was active in late August, and its Norway site is running late. A reported Microsoft withdrawal from a UK deal is unconfirmed. The final price, and whether contracts become revenue, remain unknown.",
   "edited": "none",
   "explainer": "sonnet"
  },
  {
   "id": "anthropic-fund",
   "headline": "Anthropic pledges 5% of its shares to a public benefit fund",
   "facts": [
    "5% of shares to Anthropic Public Benefit Fund, subject to shareholder approval",
    "+2% per 50% value rise above undisclosed baseline",
    "~20% of shares to public good including earlier pledges"
   ],
   "sources": [
    "https://www.anthropic.com/news/public-benefit-fund",
    "https://ca.finance.yahoo.com/news/anthropic-commit-5-stake-public-191115108.html"
   ],
   "paragraph": "Imagine a company setting aside a slice of itself, like a pie, to give away. Anthropic, maker of the Claude AI models, said it will commit 5% of its shares to a new Anthropic Public Benefit Fund, if shareholders approve. The board may add 2% more for each 50% rise in company value above a baseline that has not been disclosed. The fund is a wholly owned company rather than a registered charity, which allows different kinds of giving, such as large donations, direct payments to groups of people, or help with AI's effects on jobs. Its shares cannot fund lobbying or politics. With earlier pledges, about 20% of shares would go to public good. No dollar value was given, and governance details are promised only in the coming months.",
   "edited": "none",
   "explainer": "sonnet"
  },
  {
   "id": "taiwan-chip-exports",
   "headline": "Taiwan plans to make unlicensed AI chip exports to China a crime",
   "facts": [
    "Plan to add AI servers and advanced chips to Foreign Trade Act controls",
    "Plan, not law; no timeline or penalties",
    "Aug 2026: 9 indicted over 130 servers, 74 reached China (single source)"
   ],
   "sources": [
    "https://247wallst.com/investing/2026/10/17/smuggling-nvidia-chips-into-china-is-about-to-become-a-crime-in-taiwan/",
    "https://startupfortune.com/taiwan-will-make-it-a-crime-to-smuggle-ai-chips-into-china/",
    "https://www.yahoo.com/news/politics/articles/taiwan-moves-criminalize-ai-chip-083227760.html"
   ],
   "paragraph": "Today, Taiwan's rules work like a bouncer with a short list of banned names, such as Huawei and SMIC. The plan is to swap that for a rule about the destination: shipping AI servers and advanced chips to China without a licence would become a crime, whoever the buyer is. Economic Affairs Minister Kung Ming-hsin said this will correspond with US measures and give enforcement agencies more legal tools. The backdrop is smuggling: in August, nine people were indicted over 130 AI servers, of which 74 reached China, according to a single source. But this is only a plan. It needs a legal amendment, and there is no timeline, penalty or final product list yet, so how strict it will be is unknown.",
   "edited": "'The motive is smuggling' changed to 'The backdrop is smuggling' (inference not in packet)",
   "explainer": "sonnet"
  }
 ],
