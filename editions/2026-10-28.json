 "ai_stories": [
  {
   "id": "meta-raise",
   "headline": "Meta launches a stock sale of up to $95 billion for AI",
   "facts": [
    "Offerings launched 26 Oct (SEC FWP)",
    "Up to $95bn: ~$35bn underwritten now ($22.5bn common, $12.5bn mandatory convertible preferred), ~$60bn ATM from Q1 2027, no agreement yet",
    "Forward sales settle by 19 Nov 2027",
    "Nvidia to invest $3bn; Nvidia, AMD, Broadcom non-binding interest up to $5bn"
   ],
   "sources": [
    "https://www.sec.gov/Archives/edgar/data/0001326801/000119312526431036/d116268dfwp.htm",
    "https://finance.yahoo.com/markets/article/nvidia-to-invest-3-billion-in-meta-expand-partnership-on-muse-125249944.html",
    "https://www.marketscreener.com/news/nvidia-to-expand-meta-partnership-on-muse-ai-models-invest-3-billion-in-offering-ce785cddd88bfe23"
   ],
   "paragraph": "Picture a company asking investors to chip in so it can buy a great many expensive machines. Meta plans to sell up to $95 billion of new shares: about $35 billion now and about $60 billion later, gradually into the market, not before the first quarter of 2027 and with no agreement yet. Part of the money comes from forward sales, so Meta gets paid only when the agreements settle, by November 2027. The filing says only 'general corporate purposes', though Meta reportedly ties it to AI infrastructure. Nvidia says it will invest $3 billion. Will AMD and Broadcom buy too? Unknown: they only signalled non-binding interest, and final pricing is not set.",
   "edited": "none",
   "explainer": "sonnet"
  },
  {
   "id": "oracle-chips",
   "headline": "Oracle adds Google, Cerebras and SambaNova chips beside Nvidia",
   "facts": [
    "27 Oct: Nvidia deal expanded to multi-gigawatt scale with Vera Rubin",
    "Google TPUs offered by Oracle for the first time",
    "Cerebras and SambaNova focus on inference",
    "Capex target $90bn to $95bn FY2027, financing undisclosed",
    "Deal values, quantities, dates undisclosed"
   ],
   "sources": [
    "https://www.investing.com/news/stock-market-news/oracle-expands-chip-supply-deal-with-nvidia-adds-google-and-cerebras-offerings-4976437",
    "https://finance.yahoo.com/technology/article/oracle-in-effort-to-reduce-reliance-on-nvidia-adds-ai-chips-from-google-cerebras-and-sambanova-160000593.html"
   ],
   "paragraph": "A cloud company rents out computing power, like a power station sells electricity, and the machines are AI chips. Oracle said on Tuesday it is expanding its Nvidia deal to 'multi-gigawatt scale' and adding chips from Google, Cerebras and SambaNova. Training is when an AI model learns; inference is when it answers users. Reuters says Nvidia dominates training while inference is more competitive, and Cerebras and SambaNova focus on inference. Google's own chips, TPUs, reportedly arrive in another company's data centre for the first time. The motive, per Yahoo Finance, is avoiding a single supplier and containing costs. Unknown: deal values, chip quantities, rollout dates, and how Oracle will finance the purchases.",
   "edited": "none",
   "explainer": "sonnet"
  }
