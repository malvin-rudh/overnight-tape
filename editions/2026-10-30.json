 "ai_stories": [
  {
   "id": "amazon-q3",
   "headline": "Amazon's cloud speeds up, but the spending bill spooks investors",
   "facts": [
    "Q3 2026 net sales $201.9B +12%; AWS $46.0B +39%; capex $77.3B vs $35.1B (StockTitan); EPS $1.89 vs $1.97 est; after hours -11.4% at 16:02 ET"
   ],
   "sources": [
    "https://stocktitan.net/articles/amazon-q3-2026-earnings-aws-cloud-growth",
    "https://finance.yahoo.com/markets/stocks/articles/stock-market-today-oct-29-211602513.html"
   ],
   "paragraph": "AWS is Amazon's business of renting out computing power and storage over the internet, like a power company selling electricity by the hour. In the third quarter of 2026 it sold $46.0 billion, up 39% from $33.0 billion, and kept 38.7% of that as operating profit. So why did the shares drop after hours? The bill. Capital spending, meaning money put into property and equipment, hit $77.3 billion in the quarter against $35.1 billion a year earlier, and over twelve months more cash went out than came in. Those spending figures come from a single source. Whether the AI data-centre spending will earn back its cost is unknown, and the CEO's forecast of over 40% AWS growth in 2027 and 2028 is a forecast, not a result.",
   "edited": "cut 'so you never build your own generator' to meet the 130-word limit",
   "explainer": "sonnet"
  },
  {
   "id": "intel-q3",
   "headline": "Intel's AI server chips grow 78%, but a PC slowdown sinks the shares",
   "facts": [
    "Revenue $16.5B vs $16.6B FactSet; adj EPS $0.52 vs $0.41; DCAI $7.3B +78%; client $8.1B -5%; -16.82% after hours to $76.58"
   ],
   "sources": [
    "https://moneycheck.com/intel-intc-shares-drop-16-82-after-hours-despite-16-5-billion-revenue-beat/",
    "https://www.marketscreener.com/news/earnings-flash-intc-intel-posts-q3-adjusted-eps-0-52-vs-factset-est-of-0-41-ce785fdadc89f624"
   ],
   "paragraph": "A server is a computer that other computers connect to, while a PC is the one on your desk. Intel's third-quarter 2026 numbers show those two worlds pulling apart. Data Center and AI chips brought in $7.3 billion, up 78%, while PC chips brought in $8.1 billion, down 5%. Management expects PC softness to last through at least the first half of 2027 and pointed to robust demand for its Xeon server processors. Revenue of $16.5 billion landed just under the $16.6 billion estimate, yet adjusted profit per share of $0.52 beat the $0.41 estimate. Shares still fell 16.82% after hours, but thin after-hours trading can change before the open, and the fourth-quarter guidance figures were not in the sources.",
   "edited": "'strong demand' to 'robust demand' (packet wording); last clause reworded to 'the fourth-quarter guidance figures were not in the sources'",
   "explainer": "sonnet"
  },
  {
   "id": "gemini-carbon",
   "headline": "Google gives its new code-security model to defenders first",
   "facts": [
    "Gemini 4 Carbon announced 28 Oct; SEC-bench Pro 88.2%, ExploitGym 54.8%, CWE-bench 71.0%; defenders-first access via Fairwind; $2/$10 per M tokens rising to $4/$20"
   ],
   "sources": [
    "https://blog.google/innovation-and-ai/models-and-research/gemini-models/introducing-gemini-4-carbon/",
    "https://www.theneuron.ai/digest/everything-that-happened-in-ai-today-thursday-october-29-2026/"
   ],
   "paragraph": "A benchmark is just a standard exam for a model: the same questions for everyone, scored afterward. Google's Gemini 4 Carbon reports 88.2% on finding software vulnerabilities, 54.8% on exploiting them and 71.0% on patching them. Notice who graded it: Google. These are vendor-reported scores, run without guardrails, and the safety claims come from internal testing, with no independent tests in the sources. The notable choice is access. Starting this week only a subset of cyber defenders can use it, expanding gradually to trusted partners, while developers, businesses and consumers wait. Launch pricing is $2 per million input tokens, a token being a chunk of text, rising to $4 after the introductory period. Whether defenders-first actually helps defenders is unproven.",
   "edited": "none",
   "explainer": "sonnet"
  }
